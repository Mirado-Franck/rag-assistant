# Environnement virtuel local (non partagé / non versionné)
venv/
.venv/

# Python
__pycache__/
*.py[cod]

# Données générées ou privées
# Documents sources autorisés dans le dépôt
data/raw/*
!data/raw/.gitkeep
!data/raw/*.pdf
!data/raw/*.html
!data/raw/*.docx

# Téléversements utilisateurs : exclus du dépôt
data/raw/uploads/

# Données traitées
data/processed/*
!data/processed/.gitkeep
data/chroma_db/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Secrets
.env
*.key